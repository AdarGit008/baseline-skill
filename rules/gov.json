{
  "rules": [
    {
      "id": "GOV-03-codeowners-names-owner",
      "title": "CODEOWNERS exists and names an owner",
      "category": "governance",
      "severity": "blocker",
      "applies_to": [
        "node",
        "python",
        "service",
        "library"
      ],
      "source": "https://docs.github.com/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners",
      "lesson": "every path has an accountable reviewer",
      "rationale": "A CODEOWNERS file routes reviews to the people accountable for each path, in one canonical location.",
      "fix": "Add CODEOWNERS (or .github/CODEOWNERS) with at least one path→owner mapping.",
      "sources": [
        "tree"
      ],
      "on_unreachable": "skip",
      "contexts": [
        "check",
        "reconcile"
      ],
      "certainty": "deterministic",
      "check": {
        "kind": "file-contains",
        "globs": [
          "CODEOWNERS",
          ".github/CODEOWNERS",
          "docs/CODEOWNERS"
        ],
        "flags": "im",
        "pattern": "^\\s*[^#\\s]\\S*\\s+(@[\\w/-]+|[\\w.+-]+@[\\w.-]+)"
      }
    }
  ]
}
