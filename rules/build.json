{
  "rules": [
    {
      "id": "BUILD-03-ci-workflow-present",
      "title": "CI workflow present",
      "category": "build",
      "severity": "blocker",
      "lesson": "SW-1 / CTX-7 make a robot check it",
      "applies_to": [
        "node",
        "python",
        "service",
        "library"
      ],
      "rationale": "Enforcement lives in CI, not in a human remembering to run checks.",
      "fix": "Add .github/workflows/ci.yml (or equivalent) that lints, typechecks, tests.",
      "sources": [
        "tree"
      ],
      "on_unreachable": "skip",
      "contexts": [
        "check",
        "reconcile"
      ],
      "certainty": "deterministic",
      "check": {
        "kind": "any-file",
        "globs": [
          ".github/workflows/*.yml",
          ".github/workflows/*.yaml",
          ".gitlab-ci.yml",
          ".circleci/config.yml",
          "azure-pipelines.yml"
        ]
      }
    },
    {
      "id": "BUILD-04-env-template-present",
      "title": "Env/secret template present",
      "category": "build",
      "severity": "blocker",
      "lesson": "SW-1",
      "applies_to": [
        "node",
        "python",
        "service"
      ],
      "rationale": "A joining dev can boot without guessing env vars; keeps secrets out of code.",
      "fix": "Add .env.example enumerating every required var (no real values).",
      "sources": [
        "tree"
      ],
      "on_unreachable": "skip",
      "contexts": [
        "check",
        "reconcile"
      ],
      "certainty": "deterministic",
      "check": {
        "kind": "any-file",
        "globs": [
          ".env.example",
          ".env.sample",
          ".env.template",
          "env.example"
        ]
      }
    }
  ]
}
